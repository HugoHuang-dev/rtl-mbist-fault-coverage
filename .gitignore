# Local build and simulation workspaces
.build/
**/.build*/
**/.Xil/
**/xsim.dir/
**/__pycache__/
*.pyc
*.vvp
*.dcp
*.pb
*.jou
**/*.cache/
**/*.runs/
**/*.srcs/
**/*.gen/
**/*.ip_user_files/
**/*.hw/
**/*.sim/
*.xpr

# The ASIC RTL-view project uses relative source paths and is maintained.
!/asic/vivado/mbist_asic_v10/mbist_asic_v10.xpr
!/asic/vivado/mbist_asic_v10/mbist_asic_v10.ip_user_files/
/asic/vivado/mbist_asic_v10/mbist_asic_v10.ip_user_files/*
!/asic/vivado/mbist_asic_v10/mbist_asic_v10.ip_user_files/.gitkeep

# Initial board-project state is regenerated by the current build scripts.
/fpga/vivado/*
!/fpga/vivado/README.md

# Machine-specific configuration and session output
toolchain.local.json
/vivado*.log
/webtalk*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# Archived results/**/*.log and evidence/**/*.log are intentionally tracked.
# Native ILA data and the portable WDB/WCFG pair are also retained.
